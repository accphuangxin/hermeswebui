<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleLocalizations</key>
  <array>
    <string>en</string>
    <string>zh_CN</string>
    <string>zh_TW</string>
    <string>ja</string>
  </array>
  <key>CFBundleDevelopmentRegion</key>
  <string>zh_CN</string>
  <!-- 注册 ccswitch:// 自定义 URL 协议，用于深链接导入 -->
  <key>CFBundleURLTypes</key>
  <array>
    <dict>
      <key>CFBundleURLName</key>
      <string>CC Switch Deep Link</string>
      <key>CFBundleURLSchemes</key>
      <array>
        <string>ccswitch</string>
      </array>
    </dict>
  </array>
  <!-- 允许 WebView 内嵌加载明文 HTTP 页面（智能采购等外部嵌入页） -->
  <key>NSAppTransportSecurity</key>
  <dict>
    <key>NSAllowsArbitraryLoadsInWebContent</key>
    <true/>
  </dict>
  <!-- 聊天语音输入需要访问麦克风（WKWebView 的 getUserMedia） -->
  <key>NSMicrophoneUsageDescription</key>
  <string>用于聊天输入框的语音转文字功能，录音只会发送到你自己配置的转写服务。</string>
</dict>
</plist>

